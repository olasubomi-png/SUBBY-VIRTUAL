# Copy this file to /var/www/subby-virtual/.env on the VPS. Do not commit .env.
NODE_ENV=production
HOST=127.0.0.1
PORT=3003
APP_URL=https://subomivirtual.kdns.fr

# Required production persistence. Use PostgreSQL only; do not use MySQL or TiDB URLs.
DATABASE_URL=postgresql://subby_app:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:5432/subby_virtual

# Recommended production rate-limit storage. Keep Redis bound to loopback or a private network.
REDIS_URL=redis://127.0.0.1:6379

# Required server-side session signing secret. Generate a long random value on the VPS.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Self-hosted email/password authentication.
# The first signup matching this normalized email receives the admin role.
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Existing Forge integration values. Server keys remain server-side; only documented VITE_ values are client-visible at build time.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# SMS provider selection. Default/safe value: mock (no external network calls).
# Set SMS_PROVIDER=external only when a live adapter is implemented and credentials are ready.
SMS_PROVIDER=mock
# Required only when SMS_PROVIDER=external (never commit real secrets):
SMS_PROVIDER_BASE_URL=
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_API_SECRET=

# Mail remains local-demo in Phase 1.
MAIL_PROVIDER_API_KEY=
